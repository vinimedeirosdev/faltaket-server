{
  "name": "faltaket-server",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Infraestrutura Firebase do FaltaKet: Security Rules do Firestore e testes, migração v1 -> v2 e envio dos lembretes (push).",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-faltaket",
    "test:rules": "firebase emulators:exec --only firestore --project demo-faltaket \"vitest run\"",
    "migrate:dry": "tsx scripts/migrate-v1-to-v2.ts --dry-run",
    "migrate": "tsx scripts/migrate-v1-to-v2.ts",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "lembretes": "tsx scripts/lembretes.ts",
    "test:unit": "vitest run tests/lembretes.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.0.0",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
