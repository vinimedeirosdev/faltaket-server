# =============================================================================
# Faltaket - variáveis do script de migração v1 -> v2
# Copie este arquivo para `.env` (que é ignorado pelo git) e preencha.
# Passo a passo: docs/MIGRACAO.md
# =============================================================================

# --- Service account (Console do Firebase > Configurações do projeto >
#     Contas de serviço > "Gerar nova chave privada"). Use os campos do JSON baixado.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole a chave entre aspas, com as quebras de linha escritas como \n
# (o script converte \n em quebras de linha reais).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Domínio dos e-mails sintéticos do Firebase Auth (login por username).
#     DEVE ser o mesmo valor configurado no front. Padrão: faltaket.app
AUTH_EMAIL_DOMAIN=faltaket.app

# --- UIDs (separados por vírgula) que recebem features.termo = true.
#     Na v1 havia um id de usuário fixo no código do front que liberava a página
#     "Termo"; coloque aqui esse id (e outros, se quiser).
TERMO_USER_IDS=

# --- Opcional: rodar contra os emuladores locais (dispensa as credenciais acima).
#     Defina os DOIS juntos. Suba antes com: npm run emulators
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# =============================================================================
# Lembretes (scripts/lembretes.ts): usam as MESMAS credenciais acima
# (FIREBASE_PROJECT_ID / CLIENT_EMAIL / PRIVATE_KEY). No GitHub Actions use o
# secret FIREBASE_SERVICE_ACCOUNT (o JSON inteiro da chave). Ver docs/LEMBRETES.md.
# =============================================================================
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Endereço do app (link aberto ao tocar na notificação)
# APP_URL=https://faltaket.web.app
